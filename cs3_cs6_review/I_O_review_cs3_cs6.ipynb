      "source": [
        "import pandas as pd\n",
        "\n",
        "HEAD(\"COLUMN RENAME TABLE: package -> paper\")\n",
        "\n",
        "bldg_map = [\n",
        "    (\"ID\",              \"Input_FID\",            \"Building identifier\"),\n",
        "    (\"StatisticalUnit\", \"SU3_stadt_ID\",         \"Statistical unit join key\"),\n",
        "    (\"R\",               \"Einwohner\",            \"Residents per building (EMA)\"),\n",
        "    (\"R_G\",             \"Einwohner_Erdgeschoss\", \"Ground-floor residents (EWB)\"),\n",
        "    (\"HMA\",             \"HMA\",                  \"Hazard mobility/accessibility [0-1]?\"),\n",
        "    (\"HWB\",             \"HWB\",                  \"Hazard well-being [0-1]\"),\n",
        "    (\"PFRMA\",           \"RIMA\",                 \"Risk index MA (H*E*V product)\"),\n",
        "    (\"PFRWB\",           \"RIWB\",                 \"Risk index WB (H*E*V product)\"),\n",
        "    (\"Sensitivity\",     \"Sensitivity\",          \"TOPSIS sensitivity score\"),\n",
        "    (\"CopingCapacity\",  \"CC\",                   \"TOPSIS coping capacity score\"),\n",
        "    (\"SVI\",             \"SVI\",                  \"Social Vulnerability Index\"),\n",
        "    (\"SVPF\",            \"SVF\",                  \"Social Vulnerability Factor (normalized)\"),\n",
        "    (\"PFRMA_smoothed\",  \"smoothed_RIMA\",        \"Delaunay-smoothed risk MA\"),\n",
        "    (\"PFRWB_smoothed\",  \"smoothed_RIWB\",        \"Delaunay-smoothed risk WB\"),\n",
        "    (\"Shape_Area\",      \"Shape_Area\",           \"Building footprint area (m2)\"),\n",
        "    (\"X_Coord\",         \"X_Coord\",              \"Centroid X\"),\n",
        "    (\"Y_Coord\",         \"Y_Coord\",              \"Centroid Y\"),\n",
        "]\n",
        "\n",
        "df_bldg = pd.DataFrame(bldg_map, columns=[\"Package Name\", \"Paper Name\", \"Description\"])\n",
        "renamed = df_bldg[df_bldg[\"Package Name\"] != df_bldg[\"Paper Name\"]]\n",
        "\n",
        "print(f\"\\n{BOLD}Buildings layer{X} ({len(renamed)} columns renamed, \"\n",
        "      f\"{len(df_bldg)-len(renamed)} unchanged):\\n\")\n",
        "for _, row in df_bldg.iterrows():\n",
        "    pkg, paper = row[\"Package Name\"], row[\"Paper Name\"]\n",
        "    if pkg != paper:\n",
        "        print(f\"  {Y}{pkg:<20s}{X} -> {G}{paper:<25s}{X} {row['Description']}\")\n",
        "    else:\n",
        "        print(f\"  {pkg:<20s}    {paper:<25s} {row['Description']}\")\n",
        "\n",
        "print(f\"\\n{BOLD}Statistical units layer{X}:\\n\")\n",
        "stat_map = [\n",
        "    (\"StatisticalUnit\",  \"Statistisches_Gebiet\", \"Unit identifier\"),\n",
        "    (\"Residents\",        \"Population\",           \"Population count\"),\n",
        "    (\"CopingCapacity\",   \"CC\",                   \"Coping capacity (from TOPSIS)\"),\n",
        "    (\"SVPF\",             \"SVF\",                  \"Social vulnerability factor\"),\n",
        "    (\"WR\",               \"Children_Per\",         \"Children percentage (Hamburg indicator)\"),\n",
        "    (\"C\",                \"Seniors_Per\",          \"Seniors percentage (Hamburg indicator)\"),\n",
        "    (\"ES\",               \"SGB2_Per\",             \"SGB-II percentage (Hamburg indicator)\"),\n",
        "    (\"EDQ\",              \"EDU_Per\",              \"Education percentage (Hamburg indicator)\"),\n",
        "]\n",
        "for pkg, paper, desc in stat_map:\n",
        "    if pkg != paper:\n",
        "        print(f\"  {Y}{pkg:<20s}{X} -> {G}{paper:<25s}{X} {desc}\")\n",
        "    else:\n",
        "        print(f\"  {pkg:<20s}    {paper:<25s} {desc}\")\n"
      ]
