      "source": [
        "# Color helpers\n",
        "R = '\\033[91m'; G = '\\033[92m'; Y =  '\\033[38;5;208m'; B = '\\033[94m'; X = '\\033[0m'; BOLD = '\\033[1m'\n",
        "\n",
        "def PASS(msg):  print(f\"{G}[PASS]{X} {msg}\")\n",
        "def WARN(msg):  print(f\"{Y}[WARN]{X} {msg}\")\n",
        "def FAIL(msg):  print(f\"{R}[FAIL]{X} {msg}\")\n",
        "def INFO(msg):  print(f\"{B}[INFO]{X} {msg}\")\n",
        "def HEAD(msg):  print(f\"\\n{BOLD}{'='*60}\\n  {msg}\\n{'='*60}{X}\")\n"
      ]
    },
